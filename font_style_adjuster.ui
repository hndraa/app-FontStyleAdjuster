  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget#centralwidget {
    background-color: #0f172a;
    color: #e2e8f0;
}
QLabel {
    color: #e2e8f0;
}
QLabel#eyebrowLabel {
    color: #a5b4fc;
    font-size: 10pt;
    font-weight: 700;
}
QLabel#titleLabel {
    color: #f8fafc;
    font-size: 24pt;
    font-weight: 700;
}
QLabel#subtitleLabel {
    color: #94a3b8;
    font-size: 10pt;
}
QFrame#previewCard, QFrame#controlCard {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 16px;
}
QLabel#previewLabel {
    border-radius: 12px;
}
QLabel#fontSizeValue, QLabel#fontColorValue,
QLabel#backgroundColorValue {
    background-color: #312e81;
    color: #e0e7ff;
    border-radius: 7px;
    padding: 5px 8px;
    font-weight: 700;
}
QSlider::groove:horizontal {
    height: 6px;
    background: #334155;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #818cf8;
    border-radius: 3px;
}
QSlider::add-page:horizontal {
    background: #334155;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #c7d2fe;
    border: 2px solid #818cf8;
    width: 16px;
    margin: -7px 0;
    border-radius: 9px;
}
QPushButton {
    background-color: #6366f1;
    color: white;
    border: none;
    border-radius: 9px;
    padding: 10px 16px;
    font-weight: 700;
}
QPushButton:hover {
    background-color: #4f46e5;
}
QPushButton#closeButton {
    background-color: #334155;
}
QPushButton#closeButton:hover {
    background-color: #475569;
}
   </string>
